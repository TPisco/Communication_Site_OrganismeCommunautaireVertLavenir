@model VertLavenir.Models.Evenement

@{
    ViewData["Title"] = "Nouvel événement";
}

<h1 class="text-primary">📅 Nouvel événement</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titre" class="form-label fw-bold"></label>
                <input asp-for="Titre" class="form-control" placeholder="Nom de l'événement" />
                <span asp-validation-for="Titre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold"></label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Description de l'événement..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DateDebut" class="form-label fw-bold"></label>
                    <input asp-for="DateDebut" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                    <span asp-validation-for="DateDebut" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DateFin" class="form-label fw-bold"></label>
                    <input asp-for="DateFin" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                    <span asp-validation-for="DateFin" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Lieu" class="form-label fw-bold"></label>
                    <input asp-for="Lieu" class="form-control" placeholder="Adresse ou nom du lieu" />
                    <span asp-validation-for="Lieu" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="NombreMaxParticipants" class="form-label fw-bold"></label>
                    <input asp-for="NombreMaxParticipants" class="form-control" type="number" min="1" placeholder="Laisser vide si illimité" />
                    <span asp-validation-for="NombreMaxParticipants" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="EstActif" class="form-check-input" />
                <label asp-for="EstActif" class="form-check-label">Événement actif</label>
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Créer" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
