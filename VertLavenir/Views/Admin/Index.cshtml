@{
    ViewData["Title"] = "Tableau de bord";
}

<h1 class="text-success mb-4">📊 Tableau de bord — Administration</h1>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-success shadow">
            <div class="card-body text-center">
                <h2 class="display-4 fw-bold">@ViewBag.NombreArticles</h2>
                <p class="card-text fs-5">Articles au total</p>
                <p class="small">@ViewBag.NombreArticlesPublies publié(s)</p>
                <a asp-controller="Articles" asp-action="Index" class="btn btn-light btn-sm">Gérer</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow">
            <div class="card-body text-center">
                <h2 class="display-4 fw-bold">@ViewBag.NombreEvenements</h2>
                <p class="card-text fs-5">Événements au total</p>
                <p class="small">@ViewBag.NombreEvenementsActifs à venir</p>
                <a asp-controller="Evenements" asp-action="Index" class="btn btn-light btn-sm">Gérer</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning shadow">
            <div class="card-body text-center">
                <h2 class="display-4 fw-bold">@ViewBag.NombreMembres</h2>
                <p class="card-text fs-5">Membres au total</p>
                <p class="small">@ViewBag.NombreMembresActifs actif(s)</p>
                <a asp-controller="Membres" asp-action="Index" class="btn btn-light btn-sm">Gérer</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white">📰 Articles</div>
            <div class="card-body d-flex flex-column">
                <p>Gérez les articles et nouvelles publiés sur le site.</p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Articles" asp-action="Index" class="btn btn-outline-success btn-sm">Liste</a>
                    <a asp-controller="Articles" asp-action="Create" class="btn btn-success btn-sm">+ Nouveau</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white">📅 Événements</div>
            <div class="card-body d-flex flex-column">
                <p>Gérez les événements et activités de l'organisme.</p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Evenements" asp-action="Index" class="btn btn-outline-primary btn-sm">Liste</a>
                    <a asp-controller="Evenements" asp-action="Create" class="btn btn-primary btn-sm">+ Nouveau</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-warning text-dark">👥 Membres</div>
            <div class="card-body d-flex flex-column">
                <p>Gérez les membres et bénévoles de l'organisme.</p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Membres" asp-action="Index" class="btn btn-outline-warning btn-sm">Liste</a>
                    <a asp-controller="Membres" asp-action="Create" class="btn btn-warning btn-sm">+ Nouveau</a>
                </div>
            </div>
        </div>
    </div>
</div>
