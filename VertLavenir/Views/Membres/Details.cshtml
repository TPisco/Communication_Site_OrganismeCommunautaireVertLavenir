@model VertLavenir.Models.Membre

@{
    ViewData["Title"] = "Détails du membre";
}

<h1 class="text-warning">👥 @Model.NomComplet</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Prénom</dt>
    <dd class="col-sm-9">@Model.Prenom</dd>

    <dt class="col-sm-3">Nom</dt>
    <dd class="col-sm-9">@Model.Nom</dd>

    <dt class="col-sm-3">Courriel</dt>
    <dd class="col-sm-9"><a href="mailto:@Model.Courriel">@Model.Courriel</a></dd>

    <dt class="col-sm-3">Téléphone</dt>
    <dd class="col-sm-9">@(Model.Telephone ?? "—")</dd>

    <dt class="col-sm-3">Rôle</dt>
    <dd class="col-sm-9">@(Model.Role ?? "—")</dd>

    <dt class="col-sm-3">Date d'adhésion</dt>
    <dd class="col-sm-9">@Model.DateAdhesion.ToString("d MMMM yyyy")</dd>

    <dt class="col-sm-3">Statut</dt>
    <dd class="col-sm-9">
        @if (Model.EstActif)
        {
            <span class="badge bg-success">Actif</span>
        }
        else
        {
            <span class="badge bg-secondary">Inactif</span>
        }
    </dd>
</dl>

<div class="d-flex gap-2 mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Modifier</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Retour à la liste</a>
</div>
