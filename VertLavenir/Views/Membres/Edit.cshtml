@model VertLavenir.Models.Membre

@{
    ViewData["Title"] = "Modifier le membre";
}

<h1 class="text-warning">👥 Modifier le membre</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Prenom" class="form-label fw-bold"></label>
                    <input asp-for="Prenom" class="form-control" />
                    <span asp-validation-for="Prenom" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Nom" class="form-label fw-bold"></label>
                    <input asp-for="Nom" class="form-control" />
                    <span asp-validation-for="Nom" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Courriel" class="form-label fw-bold"></label>
                <input asp-for="Courriel" class="form-control" type="email" />
                <span asp-validation-for="Courriel" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Telephone" class="form-label fw-bold"></label>
                    <input asp-for="Telephone" class="form-control" />
                    <span asp-validation-for="Telephone" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Role" class="form-label fw-bold"></label>
                    <select asp-for="Role" class="form-select">
                        <option value="">-- Choisir un rôle --</option>
                        <option value="Membre">Membre</option>
                        <option value="Bénévole">Bénévole</option>
                        <option value="Administrateur">Administrateur</option>
                        <option value="Partenaire">Partenaire</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="DateAdhesion" class="form-label fw-bold"></label>
                <input asp-for="DateAdhesion" class="form-control" type="date" />
                <span asp-validation-for="DateAdhesion" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="EstActif" class="form-check-input" />
                <label asp-for="EstActif" class="form-check-label">Membre actif</label>
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Enregistrer" class="btn btn-warning" />
                <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
