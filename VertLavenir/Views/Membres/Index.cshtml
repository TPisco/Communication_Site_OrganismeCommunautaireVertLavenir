@model IEnumerable<VertLavenir.Models.Membre>

@{
    ViewData["Title"] = "Gestion des membres";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="text-warning">👥 Membres</h1>
    <a asp-action="Create" class="btn btn-warning">+ Nouveau membre</a>
</div>

<a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">← Tableau de bord</a>

@if (!Model.Any())
{
    <div class="alert alert-info">Aucun membre pour le moment. Ajoutez le premier!</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-warning">
                <tr>
                    <th>Nom complet</th>
                    <th>Courriel</th>
                    <th>Téléphone</th>
                    <th>Rôle</th>
                    <th>Date d'adhésion</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NomComplet</td>
                        <td>@item.Courriel</td>
                        <td>@(item.Telephone ?? "—")</td>
                        <td>@(item.Role ?? "—")</td>
                        <td>@item.DateAdhesion.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.EstActif)
                            {
                                <span class="badge bg-success">Actif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactif</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Détails</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Modifier</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Supprimer</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
