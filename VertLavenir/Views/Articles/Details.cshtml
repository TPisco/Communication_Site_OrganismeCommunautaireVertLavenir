@model VertLavenir.Models.Article

@{
    ViewData["Title"] = "Détails de l'article";
}

<h1 class="text-success">📰 @Model.Titre</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-3">Catégorie</dt>
            <dd class="col-sm-9">@(Model.Categorie ?? "—")</dd>

            <dt class="col-sm-3">Auteur</dt>
            <dd class="col-sm-9">@(Model.Auteur ?? "—")</dd>

            <dt class="col-sm-3">Date de publication</dt>
            <dd class="col-sm-9">@Model.DatePublication.ToString("d MMMM yyyy à H:mm")</dd>

            <dt class="col-sm-3">Statut</dt>
            <dd class="col-sm-9">
                @if (Model.EstPublie)
                {
                    <span class="badge bg-success">Publié</span>
                }
                else
                {
                    <span class="badge bg-secondary">Brouillon</span>
                }
            </dd>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <dt class="col-sm-3">Image</dt>
                <dd class="col-sm-9"><a href="@Model.ImageUrl" target="_blank">@Model.ImageUrl</a></dd>
            }
        </dl>

        <h4 class="mt-3">Contenu</h4>
        <div class="border rounded p-3 bg-light">
            @Model.Contenu
        </div>

        <div class="d-flex gap-2 mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Modifier</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Retour à la liste</a>
        </div>
    </div>
</div>
