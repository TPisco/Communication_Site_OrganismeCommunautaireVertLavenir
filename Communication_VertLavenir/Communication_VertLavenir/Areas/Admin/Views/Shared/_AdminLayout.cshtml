@{
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    string Active(string c) => controller.Equals(c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Vert l'avenir</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/fe/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar vl-navbar px-3">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-tree-fill vl-brand-icon"></i> Vert l'avenir <span class="badge bg-success ms-2">Admin</span>
        </a>
        <div class="d-flex gap-3 align-items-center">
            <a class="small" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-up-right"></i> Site public</a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-vl-outline" type="submit">Déconnexion</button>
            </form>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <aside class="col-md-3 col-lg-2 admin-sidebar p-3">
                <a class="@Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Tableau de bord</a>
                <a class="@Active("Events")" asp-controller="Events" asp-action="Index"><i class="bi bi-calendar-event"></i> Évènements</a>
                <a class="@Active("Donations")" asp-controller="Donations" asp-action="Index"><i class="bi bi-cash-coin"></i> Dons</a>
                <a class="@Active("Members")" asp-controller="Members" asp-action="Index"><i class="bi bi-people"></i> Membres</a>
                <a class="@Active("Messages")" asp-controller="Messages" asp-action="Index"><i class="bi bi-envelope"></i> Messages</a>
                <a class="@Active("Content")" asp-controller="Content" asp-action="Index"><i class="bi bi-gear"></i> Contenu &amp; paramètres</a>
            </aside>
            <main class="col-md-9 col-lg-10 p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
