@model OrgValue
@{ ViewData["Title"] = "Valeur"; }
<h1 class="section-title mb-4">@(Model.Id == 0 ? "Nouvelle valeur" : "Modifier la valeur")</h1>
<div class="vl-card p-4 col-lg-8">
    <form asp-action="EditValue" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="TitleFr" class="form-label">Titre (FR)</label><input asp-for="TitleFr" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="TitleEn" class="form-label">Titre (EN)</label><input asp-for="TitleEn" class="form-control" /></div>
            <div class="col-12"><label asp-for="DescriptionFr" class="form-label">Description (FR)</label><textarea asp-for="DescriptionFr" rows="2" class="form-control"></textarea></div>
            <div class="col-12"><label asp-for="DescriptionEn" class="form-label">Description (EN)</label><textarea asp-for="DescriptionEn" rows="2" class="form-control"></textarea></div>
            <div class="col-md-8"><label asp-for="ImageUrl" class="form-label">Image URL</label><input asp-for="ImageUrl" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="DisplayOrder" class="form-label">Ordre</label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
        </div>
        <button class="btn btn-vl mt-3">Enregistrer</button>
        <a class="btn btn-link" asp-action="Index">Annuler</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
