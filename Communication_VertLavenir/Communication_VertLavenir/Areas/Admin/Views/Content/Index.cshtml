@{
    ViewData["Title"] = "Contenu & paramètres";
    var settings = ViewBag.Settings as List<SiteSetting> ?? new();
    var metrics = ViewBag.Metrics as List<ImpactMetric> ?? new();
    var values = ViewBag.Values as List<OrgValue> ?? new();
    var actions = ViewBag.Actions as List<KeyAction> ?? new();
}

<h1 class="section-title mb-4">Contenu &amp; paramètres</h1>

<div class="vl-card p-4 mb-4">
    <h5 class="section-title-sm mb-3">Paramètres du site</h5>
    <form asp-action="SaveSettings" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            @foreach (var s in settings)
            {
                <div class="col-md-6">
                    <label class="form-label small">@s.Key</label>
                    @if ((s.Value ?? "").Length > 60 || s.Key.Contains("Mission") || s.Key.Contains("Hours"))
                    {
                        <textarea name="settings[@s.Key]" rows="3" class="form-control">@s.Value</textarea>
                    }
                    else
                    {
                        <input name="settings[@s.Key]" value="@s.Value" class="form-control" />
                    }
                </div>
            }
        </div>
        <button class="btn btn-vl mt-3">Enregistrer les paramètres</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="vl-card p-4">
            <div class="d-flex justify-content-between mb-2">
                <h6 class="section-title-sm mb-0">Métriques d'impact</h6>
                <a class="btn btn-sm btn-vl-outline" asp-action="EditMetric"><i class="bi bi-plus"></i></a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var m in metrics)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>@m.Value</strong> @m.LabelFr</span>
                        <span>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="EditMetric" asp-route-id="@m.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteMetric" method="post" class="d-inline" onsubmit="return confirm('Supprimer ?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="vl-card p-4">
            <div class="d-flex justify-content-between mb-2">
                <h6 class="section-title-sm mb-0">Valeurs</h6>
                <a class="btn btn-sm btn-vl-outline" asp-action="EditValue"><i class="bi bi-plus"></i></a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var v in values)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@v.TitleFr</span>
                        <span>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="EditValue" asp-route-id="@v.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteValue" method="post" class="d-inline" onsubmit="return confirm('Supprimer ?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@v.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="vl-card p-4">
            <div class="d-flex justify-content-between mb-2">
                <h6 class="section-title-sm mb-0">Actions clés</h6>
                <a class="btn btn-sm btn-vl-outline" asp-action="EditAction"><i class="bi bi-plus"></i></a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var a in actions)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@a.TitleFr</span>
                        <span>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="EditAction" asp-route-id="@a.Id"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteAction" method="post" class="d-inline" onsubmit="return confirm('Supprimer ?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
