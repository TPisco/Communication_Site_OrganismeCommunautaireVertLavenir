@model AboutViewModel
@{
    ViewData["Title"] = T["Nav_About"].Value;
}

<section class="container py-4">
    <div class="vl-hero">
        <div class="vl-hero-inner col-lg-7">
            <span class="vl-badge-pill"><i class="bi bi-geo-alt"></i> @T["Home_Badge"]</span>
            <h1 class="display-5 fw-bold">Vert l'avenir</h1>
            <p class="lead">@T["About_HeroSubtitle"]</p>
        </div>
    </div>
</section>

<section class="section-cream py-5">
    <div class="container">
        <p class="eyebrow mb-2">@T["Section_WhoWeAre"]</p>
        <h2 class="section-title mb-3">@T["Section_OurMission"]</h2>
        <p class="text-muted col-lg-9">@Model.Mission</p>
    </div>
</section>

<section class="py-5">
    <div class="container text-center">
        <h2 class="section-title mb-4">@T["Section_OurValues"]</h2>
        <div class="row g-4">
            @foreach (var v in Model.Values)
            {
                <div class="col-md-4">
                    <div class="vl-value-card">
                        <img src="https://images.unsplash.com/photo-1532601224476-15c79f2f7a51?auto=format&fit=crop&w=600&q=60" alt="@v.TitleLoc" />
                        <div class="overlay">
                            <h5 class="mb-1">@v.TitleLoc</h5>
                            <p class="small mb-0">@v.DescriptionLoc</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="section-cream py-5">
    <div class="container text-center">
        <h2 class="section-title mb-4">@T["Section_OurImpact"]</h2>
        <div class="row g-4">
            @foreach (var m in Model.Metrics)
            {
                <div class="col-6 col-md-3">
                    <div class="vl-metric-value">@m.Value</div>
                    <div class="vl-metric-label">@m.LabelLoc</div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <h2 class="section-title mb-4 text-center">@T["Section_WhatWeDo"]</h2>
        <div class="row g-3">
            @foreach (var a in Model.KeyActions)
            {
                <div class="col-md-6">
                    <div class="vl-card p-3 d-flex gap-3 align-items-start">
                        <div class="vl-icon-circle flex-shrink-0"><i class="bi @(a.Icon ?? "bi-leaf")"></i></div>
                        <div>
                            <h6 class="section-title-sm mb-1">@a.TitleLoc</h6>
                            <p class="text-muted small mb-0">@a.DescriptionLoc</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="section-green py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-2">@T["Btn_JoinMovement"]</h2>
        <p class="mb-4">@T["Home_CTA_Subtitle"]</p>
        <a class="btn btn-vl-light btn-lg" asp-controller="Account" asp-action="Register">@T["Btn_BecomeVolunteer"] <i class="bi bi-arrow-right"></i></a>
    </div>
</section>
