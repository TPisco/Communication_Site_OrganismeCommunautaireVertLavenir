@model Communication_VertLavenir.Models.evenement

<h1>Supprimer</h1>

<h3>Es-tu sûr de vouloir supprimer cet événement ?</h3>

<div>
    <p><strong>Nom: @Model.nom</strong></p>
    <p><strong>Date: @Model.date.ToShortDateString()</strong></p>
    <p><strong>Description: @Model.description</strong></p>
    <p><strong>Type: @Model.type</strong></p>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="id" />
    <button type="submit">Supprimer</button>
</form>

<a asp-action="Index">Annuler</a>