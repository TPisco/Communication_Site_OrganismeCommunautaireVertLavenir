@inject ICurrentUserService CurrentUser
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var path = Context.Request.Path + Context.Request.QueryString;
    string langName = lang switch { "en" => "EN", "es" => "ES", _ => "FR" };
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vert l'avenir</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/fe/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg vl-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-tree-fill vl-brand-icon"></i> Vert l'avenir
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">@T["Nav_Home"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Donations" asp-action="Index">@T["Nav_Donations"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">@T["Nav_About"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Calendar">@T["Nav_Calendar"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">@T["Nav_Events"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Contact" asp-action="Index">@T["Nav_Contact"]</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown lang-switch">
                            <button class="btn btn-sm btn-vl-outline dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-globe2"></i> @langName
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item @(lang == "fr" ? "active" : "")" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="fr-CA" asp-route-returnUrl="@path">@T["Lang_French"]</a></li>
                                <li><a class="dropdown-item @(lang == "en" ? "active" : "")" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="en-CA" asp-route-returnUrl="@path">@T["Lang_English"]</a></li>
                                <li><a class="dropdown-item @(lang == "es" ? "active" : "")" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="es-ES" asp-route-returnUrl="@path">@T["Lang_Spanish"]</a></li>
                            </ul>
                        </div>
                        @if (CurrentUser.IsAuthenticated)
                        {
                            @if (CurrentUser.Role == nameof(UserRole.Admin) || CurrentUser.Role == nameof(UserRole.Staff))
                            {
                                <a class="btn btn-vl-outline btn-sm" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@T["Nav_Admin"]</a>
                            }
                            <a class="nav-link small" asp-controller="Account" asp-action="Profile">@T["Nav_MyAccount"]</a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link nav-link small p-0">@T["Nav_Logout"]</button>
                            </form>
                        }
                        else
                        {
                            <a class="nav-link small" asp-controller="Account" asp-action="Login">@T["Nav_Login"]</a>
                            <a class="btn btn-vl btn-sm" asp-controller="Account" asp-action="Register">@T["Btn_BecomeVolunteer"]</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="container mt-3"><div class="alert alert-success">@TempData["Success"]</div></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3"><div class="alert alert-danger">@TempData["Error"]</div></div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="vl-footer pt-5 pb-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="d-flex align-items-center gap-2 text-white"><i class="bi bi-tree-fill"></i> Vert l'avenir</h5>
                    <p class="small mt-2 mb-3" style="max-width: 22rem;">@T["Footer_Tagline"]</p>
                    <div class="vl-social-row">
                        <a class="vl-social" href="@(ViewBag.SocialFacebook ?? "#")" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a class="vl-social" href="@(ViewBag.SocialInstagram ?? "#")" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a class="vl-social" href="@(ViewBag.SocialLinkedIn ?? "#")" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <h6>@T["Footer_Navigation"]</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a asp-controller="Home" asp-action="Index">@T["Nav_Home"]</a></li>
                        <li class="mb-1"><a asp-controller="Home" asp-action="About">@T["Nav_About"]</a></li>
                        <li class="mb-1"><a asp-controller="Events" asp-action="Index">@T["Nav_Events"]</a></li>
                        <li class="mb-1"><a asp-controller="Events" asp-action="Calendar">@T["Nav_Calendar"]</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-3 col-6">
                    <h6>@T["Footer_Resources"]</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a asp-controller="Donations" asp-action="Index">@T["Nav_Donations"]</a></li>
                        <li class="mb-1"><a asp-controller="Contact" asp-action="Index">@T["Nav_Contact"]</a></li>
                        <li class="mb-1"><a asp-controller="Account" asp-action="Register">@T["Btn_BecomeVolunteer"]</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-12">
                    <h6>@T["Footer_Contact"]</h6>
                    <p class="small mb-1">@ViewBag.ContactEmail</p>
                    <p class="small mb-1">@ViewBag.ContactPhone</p>
                    <p class="small mb-0">@ViewBag.ContactAddress</p>
                </div>
            </div>
            <hr class="border-light opacity-25 my-4" />
            <div class="text-center small">
                &copy; @DateTime.Now.Year Vert l'avenir. @T["Footer_Rights"]
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/fe/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
