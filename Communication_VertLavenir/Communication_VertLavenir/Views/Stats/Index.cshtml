@model Communication_VertLavenir.Views.ViewModels.StatsViewModel
    
@{
    ViewData["Title"] = "Statistiques";
}

<h1>Statistiques</h1>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Utilisateurs</h5>
                    <p class="card-text fs-3">@Model.TotalUtilisateurs</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Paiements</h5>
                    <p class="card-text fs-3">@Model.TotalPaiements</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Événements</h5>
                    <p class="card-text fs-3">@Model.TotalEvenements</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white bg-dark mb-3">
            <div class="card-body">
                <h5 class="card-title">Montant total reçu</h5>
                <p class="card-text fs-3">@Model.TotalMontantRecolte.ToString("0.00") $</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h3>Utilisateurs par rôle</h3>
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Rôle</th>
                        <th>Nombre</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.UtilisateursParRole)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td>@item.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-md-6">
            <h3>Événements par type</h3>
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Nombre</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.EvenementsParType)
                    {
                        <tr>
                            <td>@item.Key</td>
                            <td>@item.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>