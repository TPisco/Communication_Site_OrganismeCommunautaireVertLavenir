@model Donation
@{
    ViewData["Title"] = T["Ty_Title"].Value;
}

<section class="py-5">
    <div class="container">
        <div class="col-lg-6 mx-auto vl-form-card p-5 text-center">
            <div class="vl-icon-circle mx-auto mb-3" style="width:64px;height:64px;font-size:1.8rem;"><i class="bi bi-check-lg"></i></div>
            <h2 class="section-title-sm">@T["Ty_Title"]</h2>
            <p class="text-muted">@T["Ty_SentTo"] <strong>@Model.Email</strong>.</p>

            <ul class="list-group text-start my-4">
                <li class="list-group-item d-flex justify-content-between"><span>@T["Common_Amount"]</span><strong>@Model.Amount.ToString("C")</strong></li>
                <li class="list-group-item d-flex justify-content-between"><span>@T["Common_Donor"]</span><span>@Model.DonorName</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>@T["Common_Method"]</span><span>@Model.PaymentMethod</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>@T["Common_Status"]</span><span class="badge bg-success">@Model.Status</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>@T["Common_Date"]</span><span>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span></li>
            </ul>

            <a class="btn btn-vl" asp-controller="Home" asp-action="Index">@T["Btn_BackHome"]</a>
        </div>
    </div>
</section>
