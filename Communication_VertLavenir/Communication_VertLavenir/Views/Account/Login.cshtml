@model LoginViewModel
@{
    ViewData["Title"] = T["Auth_LoginTitle"].Value;
}

<section class="section-green py-5">
    <div class="container">
        <div class="col-md-6 col-lg-5 mx-auto vl-form-card p-4 p-md-5 my-4">
            <h2 class="text-vl-green fw-bold">@T["Auth_LoginTitle"]</h2>
            <p class="text-muted">@T["Auth_LoginSubtitle"]</p>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">@T["Field_Email"]</label>
                    <input asp-for="Email" class="form-control" placeholder="exemple@courriel.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">@T["Field_Password"]</label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">@T["Auth_RememberMe"]</label>
                </div>
                <button type="submit" class="btn btn-vl w-100">@T["Btn_SignIn"]</button>
            </form>

            <p class="text-center mt-3 mb-0">
                @T["Auth_NoAccount"]
                <a asp-action="Register" class="fw-semibold">@T["Auth_SignUpLink"]</a>
            </p>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
